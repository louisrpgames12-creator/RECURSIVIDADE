#include <stdio.h>

int multiplicacao(int n1, int n2) {
    if (n2 == 1) {
        return n1;
    }
    return n1 * multiplicacao(n1, n2 - 1);
}

int main() {
    int n1, n2;
    
    printf("DIGITE N1 E N2: ");
    scanf("%d%d", &n1,&n2);
    printf("%d", multiplicacao(n1, n2));
    
    return 0;
}
