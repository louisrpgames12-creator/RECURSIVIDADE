#include <stdio.h>

int tribonacci(int numero) {
    if(numero == 0 || numero == 1)
        return 0;
    else
        if(numero == 2)
            return 1;
    return tribonacci(numero - 1) + tribonacci(numero - 2) + tribonacci(numero - 3);
}

int main() {
    int numero;
    
    printf("ME INFORME UM NUMERO: ");
    scanf("%d", &numero);

    printf("%d",tribonacci(numero));
    return 0;
}
